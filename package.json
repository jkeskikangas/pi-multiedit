    "@ast-grep/lang-csharp": "*",
    "@ast-grep/lang-php": "*",
    "@ast-grep/lang-bash": "*",
    "@ast-grep/lang-yaml": "*",
    "@ast-grep/lang-lua": "*",
    "@ast-grep/lang-scala": "*",
    "@ast-grep/lang-swift": "*"
  },
  "author": "Jarno Keskikangas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkeskikangas/pi-multiedit.git"
